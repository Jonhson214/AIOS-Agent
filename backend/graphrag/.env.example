# MinerU (required for document parsing)
MINERU_API_TOKEN=your_mineru_api_token_here

# MinerU venv path (absolute path to python.exe)
# Relative to repo: backend/graphrag/mineru_mvp/...
MINERU_PYTHON=
MINERU_PIPELINE=
